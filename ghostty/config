# ~/.config/ghostty/config

# ==========================================
# FONTE E LIGATURES
# ==========================================
font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-feature = calt
font-feature = liga

# ==========================================
# INTERFACE E TRANSPARÊNCIA
# ==========================================
# Fundo transparente (0.0 a 1.0)
background-opacity = 0.85
# Opcional: adiciona um desfoque (blur) bonito atrás do terminal
background-blur-radius = 20

# Remove margens e a barra de título superior
window-decoration = true
gtk-titlebar = true

# ==========================================
# ESTILIZAÇÃO DE CORES (Custom Palette)
# ==========================================
foreground = #cdd6f4
background = #1e1e2e
cursor-color = #f5e0dc
selection-background = #585b70
selection-foreground = #cdd6f4

# Paleta de 16 cores do terminal
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
